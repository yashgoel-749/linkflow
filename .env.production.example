# Nonsecret configuration only. Copy to .env.production and use your real domain/certificate.
DOCKER_PROJECT_NAME=linkflow-production
DOCKER_PUBLIC_BASE_URL=https://links.example.com
DOCKER_HTTP_BIND=0.0.0.0
DOCKER_HTTP_PORT=80
DOCKER_HTTPS_BIND=0.0.0.0
DOCKER_HTTPS_PORT=443
DOCKER_PROXY_SUBNET=172.30.241.0/28
DOCKER_PROXY_DYNAMIC_RANGE=172.30.241.8/29
DOCKER_PROXY_IP=172.30.241.2
DOCKER_SECRET_GID=1000
DOCKER_TLS_CERT_FILE=./.local/certificates/fullchain.pem
DOCKER_TLS_KEY_FILE=./.local/certificates/privkey.pem
# Set secret file paths to deployment-owned files, not database URLs or plaintext passwords.
DOCKER_POSTGRES_ADMIN_PASSWORD_FILE=./.local/production-secrets/postgres_admin_password
DOCKER_DB_PASSWORD_FILE=./.local/production-secrets/db_password
DOCKER_REDIS_PASSWORD_FILE=./.local/production-secrets/redis_password
DOCKER_JWT_SECRET_FILE=./.local/production-secrets/jwt_secret
DOCKER_VISITOR_SECRET_FILE=./.local/production-secrets/visitor_secret
