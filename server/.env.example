NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/linkflow?schema=public
REDIS_URL=redis://127.0.0.1:6379
REDIS_NAMESPACE=linkflow
JWT_SECRET=replace-with-at-least-32-random-characters
VISITOR_SECRET=replace-with-a-different-32-character-secret
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173
PUBLIC_BASE_URL=http://localhost:3001
