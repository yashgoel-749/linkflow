# Public configuration only. Cookies are sent to this API origin.
VITE_API_URL=http://localhost:3001/api
# Local reference folder; documentation only, not loaded by the application.
DESIGN_REFERENCE_PATH=./design_reference

# Docker settings are public. Generate private file-backed secrets with scripts/docker-setup.mjs.
DOCKER_PROJECT_NAME=linkflow-docker
DOCKER_PUBLIC_BASE_URL=http://localhost:18080
DOCKER_HTTP_BIND=127.0.0.1
DOCKER_HTTP_PORT=18080
DOCKER_PROXY_SUBNET=172.30.240.0/28
DOCKER_PROXY_DYNAMIC_RANGE=172.30.240.8/29
DOCKER_PROXY_IP=172.30.240.2
DOCKER_SECRET_GID=1000
