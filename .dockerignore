# Allowlist: private files never enter the frontend build context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.ts
!playwright.config.ts
!index.html
!src/
!src/**
!public/
!public/**
!docker/
!docker/frontend/
!docker/frontend/nginx.conf
**/.env*
**/*.pem
**/*.key
**/*.crt
**/node_modules/**
**/.local/**
